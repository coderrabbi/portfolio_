{
  "name": "@gr/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run build && node --test --test-isolation=none test/integration.test.mjs",
    "test:email": "npm run build && node --test --test-isolation=none test/email.test.mjs"
  },
  "dependencies": {
    "@gr/shared": "*",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "prisma": "7.10.0",
    "pg": "8.23.0",
    "express": "5.2.1",
    "cors": "2.8.6",
    "helmet": "8.3.0",
    "cookie-parser": "1.4.7",
    "express-rate-limit": "8.7.0",
    "argon2": "0.45.1",
    "multer": "2.4.0",
    "sharp": "0.35.4",
    "cloudinary": "2.11.0",
    "dotenv": "17.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/cors": "2.8.19",
    "@types/cookie-parser": "1.4.10",
    "@types/multer": "2.2.0",
    "@types/pg": "8.23.1",
    "supertest": "7.2.2",
    "@types/supertest": "7.2.1"
  }
}
